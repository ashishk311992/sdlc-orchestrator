# Core
ENV=production
LOG_LEVEL=INFO
API_PORT=8080

# LLM
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-5-20250929
LLM_MAX_TOKENS=8192

# GitHub
GITHUB_APP_TOKEN=
GITHUB_REPO=acme/service
GITHUB_DEFAULT_BRANCH=main
GITHUB_WEBHOOK_SECRET=

# Linear
LINEAR_API_KEY=
LINEAR_WEBHOOK_SECRET=
LINEAR_TEAM_ID=
LINEAR_TRIGGER_LABEL=ai-ship
LINEAR_IN_REVIEW_STATE_ID=
LINEAR_BLOCKED_STATE_ID=

# Infra
DATABASE_URL=postgresql+psycopg2://sdlc:sdlc@postgres:5432/sdlc
REDIS_URL=redis://redis:6379/0

# Self-healing
MAX_HEAL_ATTEMPTS=3
STAGE_TIMEOUT_SECONDS=900

# Platform callback (used by GitHub Actions to report CI results)
PLATFORM_CALLBACK_TOKEN=change-me
